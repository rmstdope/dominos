# Copy to .env for local dev. Every setting is optional locally.

# Postgres. Unset, the API keeps an embedded PGlite database in PGLITE_DIR.
# DATABASE_URL=postgres://dominos:secret@localhost:5432/dominos
# PGLITE_DIR=.data/pglite

PORT=3000
# Where the frontend runs; links in emails point here.
APP_ORIGIN=http://localhost:5173

# Unset, emails are printed to the API's log, links included.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Dominos <dominos@rmstdope.eu>

# Production only: the API sits behind Caddy.
# TRUST_PROXY=true
