# /opt/dominos/.env on the VPS. Never committed: it holds the database password and SMTP login.

# The address Caddy serves and gets a certificate for, and where links in emails point.
SITE=dominos.rmstdope.eu
APP_ORIGIN=https://dominos.rmstdope.eu

# Make one with: openssl rand -hex 32 (hex, so it is safe inside the database URL)
POSTGRES_PASSWORD=

# HostUp's relay: no login, it trusts the VPS's address. Needs the DNS records in docs/deploy.md.
# SMTP_URL=smtp://relay.hostup.se:587?requireTLS=true
# Empty: emails are written to the API's log instead (docker compose logs api).
SMTP_URL=
MAIL_FROM=Dominos <dominos@rmstdope.eu>
