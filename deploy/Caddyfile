# The shared proxy terminates TLS and routes /api directly to the API.
:8080 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /healthz {
		header Cache-Control no-cache
		respond "ok" 200
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /release.json {
		root * /srv
		header Cache-Control no-cache
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		# Any other path is a screen of the app, e.g. /events/…, so it gets index.html.
		try_files {path} /index.html
		file_server
	}
}
