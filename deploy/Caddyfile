# One site: the app and its API on the same origin, so the session cookie is first-party and
# there is no CORS. SITE is the address Caddy serves, e.g. dominos.rmstdope.eu (it then gets and
# renews the certificate itself) or ":80" for a plain-HTTP test.
# Behind the VPS's shared edge Caddy, which serves the other sites on 80/443 and forwards
# dominos.rmstdope.eu here over Docker's network. X-Forwarded-For is believed only from private
# (Docker) addresses and read right to left, so {client_ip} is the visitor the edge saw and a
# client cannot forge it. Reached directly, as in the smoke test, visitors arrive from Docker's
# private gateway, which is trusted too: so in production the ports are published on loopback only.
{
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

{$SITE} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		# The API rate-limits by the last X-Forwarded-For hop: hand it the visitor alone, not the
		# chain with the edge's address appended.
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		# Vite fingerprints everything in /assets, so those can be cached forever. Everything else,
		# index.html under any screen's path included, is checked for a new version every time.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		# Any other path is a screen of the app, e.g. /events/…, so it gets index.html.
		try_files {path} /index.html
		file_server
	}
}
